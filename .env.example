# ── Backend API ───────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Use the shared postgres-server container in production:
DATABASE_URL=postgres://wordcore:your_db_password@postgres-server:5432/wordcore?sslmode=disable

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# OpenRouter API key — get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use for sentence checking (default shown below)
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Local development only ────────────────────────────────────────────────────
# In production, frontend and API share the same origin — no env var needed.
# For local dev, create .env.local and set:
# VITE_API_BASE_URL=http://localhost:8080

# ── Voice ─────────────────────────────────────────────────────────────────────
# Clips not recorded ahead of time are recorded on first play (TTS_DAILY_CAP a day).
TTS_PROVIDER=mimo
TTS_VOICE=Mia
TTS_DAILY_CAP=500
MIMO_API_KEY=
# Only when TTS_PROVIDER=doubao
DOUBAO_TTS_API_KEY=

# ── Content pipeline (scripts/content, offline, not needed by the app) ───────
# Cards are written with DeepSeek; Gemini is the older option.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ── Umami Analytics ───────────────────────────────────────────────────────────
# Website ID from Umami dashboard (leave empty to disable tracking)
VITE_UMAMI_WEBSITE_ID=
